# Web / Vercel
DATABASE_URL="postgresql://targetjee:localpassword@localhost:5432/targetjee"
# Optional direct public Railway extraction endpoint. Set this in Vercel to bypass the
# Vercel serverless multipart limit for larger scans/PDFs; it exposes no model secret.
NEXT_PUBLIC_EXTRACTION_API_URL=""
# Private URL used only by the Next.js same-origin broker when the public endpoint is unset.
TARGETJEE_API_BASE_URL="http://127.0.0.1:8000"

# FastAPI / Railway only — never prefix these with NEXT_PUBLIC_.
# Optional server-owned Vision fallback. Leave all three blank for a Gemini-BYOK-only launch:
# learner keys entered through the frontend modal are forwarded only with that extraction request.
VISION_LLM_BASE_URL="https://api.openai.com/v1"
VISION_LLM_API_KEY=""
VISION_LLM_MODEL=""
# Comma-separated explicit browser origins, e.g. https://targetjee.vercel.app,https://app.example.com
CORS_ALLOW_ORIGINS="http://localhost:3000"
# Optional safe regex for Vercel preview URLs.
CORS_ALLOW_ORIGIN_REGEX=""
# Public-demo protection for costly Vision requests; use Redis/API-gateway quotas for multi-instance production.
EXTRACTION_RATE_LIMIT_PER_MINUTE="8"
TRUST_PROXY_HEADERS="true"
